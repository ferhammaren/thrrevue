---
import "../../styles/global.css";
const { title } = Astro.props;
const { comment } = Astro.props;
const {img} = Astro.props;
---

<div class="card bg-base-100 w-96 shadow-sm">
  <div class="card-body">
    <h2 class="card-title">{title}</h2>
    <p>{comment}</p>
  </div>
  <figure>
    <img
      src={img}
      alt="Latest Release" />
  </figure>
</div>