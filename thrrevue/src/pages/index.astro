---
import "../styles/global.css";
import BaseLayout from '../layouts/BaseLayout.astro';
import CardBottom from "../layouts/components/cardBottom.astro";
---
<BaseLayout title="Home">
  <section class="text-center px-5">
    <div class="hero min-h-80" style="background-image: url(/images/index.png);">
      <div class="hero-overlay"></div>
      <div class="hero-content text-neutral-content text-center">
        <div class="max-w-md">
          <h1 class="mb-5 text-5xl font-bold">Thunder Road Revue</h1>
            <p class="mb-5"> A fanpage dedicated to the career and projects of Takano Tetsu.</p>
        </div>
      </div>
    </div>
    <div class="py-2">
      <CardBottom title="Latest Release" comment="nil - lilill" img="/images/lilill.jpg"></CardBottom>
      <div>
        <ul class="list bg-base-100 rounded-box shadow-md">
  
  <li class="p-4 pb-2 text-xs opacity-60 tracking-wide">Latest Shows</li>
  
  <li class="list-row">
    <div>
      <div>June 8</div>
      <div class="text-xs uppercase font-semibold opacity-60">Sillys - Kichijoji PLANET K (Tokyo)</div>
    </div>
    <button class="btn btn-square btn-ghost">
      <svg class="size-[1.2em]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><g stroke-linejoin="round" stroke-linecap="round" stroke-width="2" fill="none" stroke="currentColor"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path></g></svg>
    </button>
  </li>
  
  <li class="list-row">
    <div><img class="size-10 rounded-box" src="https://img.daisyui.com/images/profile/demo/4@94.webp"/></div>
    <div>
      <div>June 10</div>
      <div class="text-xs uppercase font-semibold opacity-60">Takano Tetsu - MINAMINO ROCK FESTIVAL 2025 @ Shinjuku LOFT (Tokyo)</div>
    </div>
    <button class="btn btn-square btn-ghost">
      <svg class="size-[1.2em]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><g stroke-linejoin="round" stroke-linecap="round" stroke-width="2" fill="none" stroke="currentColor"><path d="M6 3L20 12 6 21 6 3z"></path></g></svg>
    </button>
  </li>
  
  <li class="list-row">
    <div><img class="size-10 rounded-box" src="https://img.daisyui.com/images/profile/demo/3@94.webp"/></div>
    <div>
      <div>June 14</div>
      <div class="text-xs uppercase font-semibold opacity-60">Sillys - KMC Hall (Hokkaido) </div>
    </div>
    <button class="btn btn-square btn-ghost">
      <svg class="size-[1.2em]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><g stroke-linejoin="round" stroke-linecap="round" stroke-width="2" fill="none" stroke="currentColor"><path d="M6 3L20 12 6 21 6 3z"></path></g></svg>
    </button>

  </li>
  
</ul>
      </div>
    </div>
  
  </section>
</BaseLayout>