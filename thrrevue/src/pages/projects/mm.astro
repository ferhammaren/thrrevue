---
import "../../styles/global.css";
import BaseLayout from '../../layouts/BaseLayout.astro';
import Carousel from "../../layouts/components/carousel.astro";
import CardBottom from "../../layouts/components/cardBottom.astro";
import Timeline from "../../layouts/components/timeline.astro";
---
<BaseLayout title="Thunder Road - Malice Mizer">
  <section class="text-center py-4">
     <!-- <Carousel /> -->
      <div class="hero bg-base-200 min-h-80">
  <div class="hero-content flex-col lg:flex-row">
    <img
      src="/images/mm/mmtkntts.jpg"
      class="max-w-sm rounded-lg shadow-2xl"
    />
    <div>
      <h1 class="text-5xl font-bold">Malice Mizer</h1>
      <p class="py-6">
        The legendary Visual Kei band, part of the Big 4 of Visual Kei along La'cryma Christi, Fanatic Crisis and Shazna. Tetsu was their first vocalist, performing with the band from 1992 to 1994.
        Only one official release features his vocals, although some demo tapes exist.
      </p>
    </div>
  </div>
</div>
<div class="min-h-80 py-4 px-2 flex justify-center">
